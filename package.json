{
  "name": "@cziyi/dsh-mnemosyne",
  "version": "0.2.9",
  "description": "Zero-operation OKF memory and progressive disclosure plugin for DeepSeek Harness",
  "keywords": [
    "deepseek-harness",
    "memory",
    "okf",
    "progressive-disclosure"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mchenziyi/dsh-Mnemosyne.git"
  },
  "homepage": "https://github.com/mchenziyi/dsh-Mnemosyne#readme",
  "bugs": {
    "url": "https://github.com/mchenziyi/dsh-Mnemosyne/issues"
  },
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsdown && node scripts/fix-cjs-dts.mjs",
    "prepare": "pnpm build",
    "pack": "pnpm build && pnpm exec npm pack",
    "pack:check": "node tests/pack-check.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.4",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-agent-loop": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-atomic-write": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-attachment": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-brand": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-code-runtime": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-credentials": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-credentials-local": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-deepseek-llm-api-extensions": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-fs": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-home-paths": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-launch-environment": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-sandbox": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-scope": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-session-checkpoint-policy": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-session-persistence": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-session-projection": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-timeout": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-user-approval": "0.1.2-alpha.4",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^22.15.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
